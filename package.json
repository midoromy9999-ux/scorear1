{
  "name": "scorear",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "node build.js",
    "deploy": "npm run build && npm test && npm run check:assets && npx firebase-tools deploy --only hosting,database",
    "test": "node --test tests/security-regression.test.cjs tests/api-regression.test.cjs",
    "test:rules": "node tests/rtdb-security.cjs",
    "check:assets": "node tools/check-assets.cjs",
    "deploy:scorear1": "npm run build && npm test && npm run check:assets && npx firebase-tools deploy --only hosting,database --project scorear1"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "firebase-admin": "^12.7.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.5.438",
    "sharp": "^0.35.5",
    "xlsx": "^0.18.5"
  },
  "overrides": {
    "jose": "^4.15.5"
  }
}